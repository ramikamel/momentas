# Put real values in .env.local. Never commit it.
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_TEXT_MODEL=muse-spark-1.3
META_IMAGE_MODEL=muse-image-1.0
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=memory-images
# Set APP_ORIGIN to the exact deployed origin in production.
APP_ORIGIN=http://localhost:3000
# Local durable storage is development-only. Production requires Supabase.
LOCAL_DATA_DIR=.data

META_VOICE_MODEL=muse-voice-transcribe-1.0
MAX_VOICE_REQUESTS=24
MAX_COMPARISON_REQUESTS=24
